server {
    server_name stocktrack.jrgrafisk.dk;

    location /deploy-webhook {
        proxy_pass http://127.0.0.1:9001/webhook;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/stocktrack.jrgrafisk.dk/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/stocktrack.jrgrafisk.dk/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = stocktrack.jrgrafisk.dk) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name stocktrack.jrgrafisk.dk;
    return 404; # managed by Certbot


}
