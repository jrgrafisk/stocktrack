[Unit]
Description=Stocktrack paper trading game
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/stocktrack/backend
ExecStart=/home/ubuntu/stocktrack/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
