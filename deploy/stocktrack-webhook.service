[Unit]
Description=Stocktrack deploy webhook listener
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/stocktrack
EnvironmentFile=/home/ubuntu/stocktrack/deploy/webhook.env
ExecStart=/usr/bin/python3 /home/ubuntu/stocktrack/deploy/webhook_listener.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
